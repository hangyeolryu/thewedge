rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // Users can only update their own non-role fields; admins can update role
      allow update: if isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isNiceVerified']))
        || isAdmin();
      allow delete: if false; // No user deletion via client
    }

    // Polls collection — public read, admin write
    match /polls/{pollId} {
      allow read: if true; // Public
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        // Allow vote count updates from any signed-in user (via service)
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answers', 'totalVotes']));
      allow delete: if isAdmin();
    }

    // Votes collection
    match /votes/{voteId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      // Allow reading vote counts for result aggregation (public)
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Comments collection — public read of visible+blurred, owner+admin can delete
    match /comments/{commentId} {
      allow read: if true; // public, but client filters blocked
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.text.size() <= 1000 &&
        // Toxicity score and status are set by Cloud Function — clients
        // submit with default values (0 / 'visible') and the trigger overwrites
        request.resource.data.status == 'visible';
      // Only allow flagging (adding own uid to flaggedBy) — no other field changes
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['flaggedBy']) &&
        request.auth.uid in request.resource.data.flaggedBy;
      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User stats — only readable by owner, written only by Cloud Functions
    match /user_stats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functions only (admin SDK bypasses rules)
    }
  }
}
